{
	"name": "assistant",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"packageManager": "bun@1.3.0",
	"engines": {
		"bun": "*",
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "bun run copy-pdfjs && vite build && bun run db:migrate && bun run db:seed",
		"copy-pdfjs": "cp node_modules/pdfjs-dist/build/pdf.worker.mjs* static/",
		"start": "bun ./build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx ./src/scripts/migrations.ts",
		"db:seed": "tsx ./src/scripts/seed.ts"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.27.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.19",
		"@types/busboy": "^1.5.4",
		"@types/eslint": "^9.6.1",
		"@types/hast": "^3.0.4",
		"@types/node": "^22.19.7",
		"@types/pg": "^8.16.0",
		"@types/unist": "^3.0.3",
		"cli-progress": "^3.12.0",
		"debug": "^4.4.3",
		"drizzle-kit": "^0.27.2",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"postcss": "^8.5.6",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.4.2",
		"svelte": "^5.48.0",
		"svelte-check": "^4.3.5",
		"tailwindcss": "^4.3.3",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.1",
		"vite": "^5.4.21"
	},
	"type": "module",
	"dependencies": {
		"@ai-sdk/anthropic": "^1.2.12",
		"@ai-sdk/google": "^1.2.22",
		"@ai-sdk/openai": "^1.3.24",
		"@ai-sdk/provider": "^1.1.3",
		"@aws-sdk/client-s3": "^3.975.0",
		"@aws-sdk/cloudfront-signer": "^3.975.0",
		"@aws-sdk/lib-storage": "^3.975.0",
		"@aws-sdk/s3-request-presigner": "^3.975.0",
		"@lucia-auth/adapter-drizzle": "^1.1.0",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/adapter-node": "^5.5.2",
		"@types/pdfjs-dist": "^2.10.378",
		"@zerodevx/svelte-json-view": "^1.0.11",
		"ai": "^4.3.19",
		"arctic": "^2.3.4",
		"clsx": "^2.1.1",
		"daisyui": "^5.7.7",
		"dotenv": "^16.6.1",
		"drizzle-orm": "^0.36.4",
		"file-type": "^22.0.1",
		"hast": "^1.0.0",
		"hast-util-class-list": "^2.0.1",
		"hast-util-has-property": "^3.0.0",
		"hast-util-is-element": "^3.0.0",
		"katex": "^0.16.27",
		"lowlight": "^3.3.0",
		"lucide-svelte": "^0.454.0",
		"mode-watcher": "^0.4.1",
		"pdfjs-dist": "^4.10.38",
		"pg": "^8.17.2",
		"postgres": "^3.4.8",
		"rehype-external-links": "^3.0.0",
		"rehype-highlight": "^7.0.2",
		"rehype-katex": "^7.0.1",
		"rehype-mathjax": "^6.0.0",
		"rehype-pretty-code": "^0.14.1",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark": "^15.0.1",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-html": "^16.0.1",
		"remark-math": "^6.0.0",
		"remark-rehype": "^11.1.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0"
	}
}
